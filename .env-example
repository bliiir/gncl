# Worked example. Copy to .env and it runs as-is:
#
#     cp .env-example .env
#     uv run gncl serve
#
# The credentials below are demo values, deliberately committed and deliberately
# obvious. They exist so a reviewer can start the API without inventing
# anything. CHANGE THEM before exposing any instance to a network. An instance
# on a public IP using these is unauthenticated in practice.
#
# Every variable the project reads is listed below, with the optional ones
# marked. There is no second template to keep in sync with this one.

# --- required to run the API ---
GNCL_AUTH_USER=reviewer
GNCL_AUTH_PASSWORD=demo-only-change-me

# --- required for `docker compose up` to start anything ---
# Compose has no notion of a default profile: every service here carries one, so
# without this a bare `docker compose up` matches nothing and exits 0 silently.
# `--profile vessel` on the command line replaces this value, it does not add to
# it.
COMPOSE_PROFILES=shore

# --- optional, all have working defaults ---

# Accept band. Read-time filter over stored scores; changing it does not re-run
# the pipeline.
GNCL_THRESHOLD=0.80

# Requests per minute per client key. Note this keys on the connecting address,
# so behind a proxy it is effectively global. See deploy/README.md.
GNCL_RATE_LIMIT_PER_MIN=60

# Failed logins burn this much tighter budget, so a shared credential cannot be
# brute-forced at request speed.
GNCL_AUTH_FAIL_PER_MIN=5

# --- optional, only for the local model audit ---
# Without these the pipeline still runs; the 2 name conflicts are reported
# unresolved rather than silently accepted. Needs `uv sync --extra llm` and
# `ollama pull gemma4:12b`.
#
# OLLAMA_HOST is for the CLI, running on this machine, where localhost is the
# Ollama server. Compose does NOT use it: inside a container localhost is the
# container, so sharing this value pointed the audit at itself and disabled it
# without an error. Containers use OLLAMA_HOST_IN_CONTAINER below.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b

# Where the container reaches Ollama. The default resolves to the docker host,
# which is where `ollama serve` runs in the local and EC2 setups. Set it
# explicitly if the model runs on another box.
OLLAMA_HOST_IN_CONTAINER=http://host.docker.internal:11434

# --- optional, only for the chat tab ---
# The chat tab in `gncl serve` asks a hosted model about the output. Empty is a
# supported state: the tab renders and says chat is unconfigured. Everything
# else -- resolve, the API, the tables -- works without it.
#
# This is a live billable credential. Use a personal, spend-capped key, never a
# corporate gateway one, and rotate it when a deployed instance comes down.
# Shore profile only; the vessel profile assumes no egress and leaves chat off.
#
# NOTE: a value already in your shell environment wins over this file. dotenv
# does not overwrite what is already set, so `unset ANTHROPIC_API_KEY` if you
# want the empty value here to take effect.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
